# Default: free, no paid API calls, accessible to anyone with the URL.
ENABLE_LLM=0
ENABLE_MCP=0
# To enable frontier model, configure both variables below as server secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6
COPILOT_ACCESS_TOKEN=
# MCP v2 is disabled unless enabled. Add real deployment domain and allowed origins.
MCP_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080
MCP_ALLOWED_ORIGINS=http://localhost:8080
